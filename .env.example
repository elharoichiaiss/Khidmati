# Database
DATABASE_URL=postgresql://user:password@localhost:5432/khidmati

# Session Secret - Generate a strong random key (min 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin Credentials (change these immediately!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push VAPID Keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Server Port (optional)
PORT=5000
